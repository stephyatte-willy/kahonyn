// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== UTILISATEURS ====================

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  name          String?
  email         String?   @unique
  preferredCurrency String? @default("XOF")
  country       String? 
  password      String?
  role          String    @default("client") 
  bio           String?   @db.Text
  avatar        String?
  coins         Int       @default(0)
  totalEarnings Float     @default(0)
  isActive      Boolean   @default(true) 
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations existantes
  accounts           Account[]
  sessions           Session[]
  videos             Video[]
  series             Series[]
  purchases          Purchase[]
  subscriptions      Subscription[]
  watchHistory       WatchHistory[]
  likes              Like[]
  comments           Comment[]
  notifications      Notification[]
  paymentMethods     PaymentMethod[]
  withdrawalRequests WithdrawalRequest[]
  transactions       Transaction[]
  ratings            Rating[]
  adWatches          AdWatch[]
  
  // ==================== SYSTÈME DE CADEAUX & BONUS ====================
  dailyRewards       DailyReward[]
  userMissions       UserMission[]
  sentReferrals      Referral[] @relation("sent")
  receivedReferrals  Referral[] @relation("received")
  rewardHistory      RewardHistory[]
  userStreak         UserStreak?
  
  // ==================== LOGS DE RECHERCHE ====================
  searchLogs         SearchLog[]
}

// ==================== AUTH (NextAuth) ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== CONTENU VIDÉO ====================

model Video {
  id                String    @id @default(cuid())
  title             String
  description       String?   @db.Text
  thumbnail         String?
  url               String
  duration          Int       @default(0)
  price             Int       @default(0)
  freePreview       Boolean   @default(false)
  previewDuration   Int?
  views             Int       @default(0)
  purchasesCount    Int       @default(0)
  status            String    @default("pending")
  category          String    @default("popular")
  tags              String?
  deletionRequested Boolean   @default(false)
  isDeleted         Boolean   @default(false)
  willDisappearAt   DateTime?
  rejectionReason   String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creatorId     String
  creator       User           @relation(fields: [creatorId], references: [id])
  seriesId      String?
  series        Series?        @relation(fields: [seriesId], references: [id])
  purchases     Purchase[]
  likes         Like[]
  comments      Comment[]
  watchHistory  WatchHistory[]
  notifications Notification[]
  ratings       Rating[]
  adWatches     AdWatch[]
}

model Series {
  id                String    @id @default(cuid())
  title             String
  description       String?   @db.Text
  coverImage        String?
  price             Int       @default(0)
  freeEpisodes      Int       @default(1)
  totalEpisodes     Int       @default(0)
  totalViews        Int       @default(0)
  status            String    @default("pending")
  category          String    @default("popular")
  deletionRequested Boolean   @default(false)
  isDeleted         Boolean   @default(false)
  willDisappearAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creatorId String
  creator   User      @relation(fields: [creatorId], references: [id])
  episodes  Video[]
  purchases Purchase[]
  likes     Like[]
  comments  Comment[]
}

// ==================== ENGAGEMENT ====================

model Like {
  id        String   @id @default(cuid())
  userId    String
  videoId   String?
  seriesId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video  Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@unique([userId, seriesId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  videoId   String?
  seriesId  String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video    Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  series   Series?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
}

// ==================== MONÉTISATION ====================

model Purchase {
  id            String    @id @default(cuid())
  userId        String
  videoId       String?
  seriesId      String?
  amount        Float
  coinsUsed     Int       @default(0)
  status        String    @default("completed")
  paymentMethod String    @default("coins")
  transactionId String?
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id])
  video  Video?  @relation(fields: [videoId], references: [id])
  series Series? @relation(fields: [seriesId], references: [id])
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  type            String
  amount          Float
  coins           Int
  currency        String    @default("XOF")
  paymentMethod   String
  paymentGateway  String?
  status          String    @default("pending")
  reference       String?
  gatewayResponse String?   @db.Text
  metadata        String?   @db.Text
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([reference])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Float
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  planId           String?
  plan             String
  status           String    @default("active")
  amount           Float     @default(0)
  startDate        DateTime  @default(now())
  endDate          DateTime
  autoRenew        Boolean   @default(false)
  dailyCoinsClaimed Boolean  @default(false)
  lastDailyClaim   DateTime?
  createdAt        DateTime  @default(now())

  user    User              @relation(fields: [userId], references: [id])
  planRef SubscriptionPlan? @relation(fields: [planId], references: [id])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Float    @default(0)
  priceUSD    Float?
  duration    Int      @default(30)
  coinsBonus  Int      @default(0)
  dailyCoins  Int      @default(0)
  benefits    String?  @db.Text
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  color       String?
  badge       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model PaymentGateway {
  id            String   @id @default(cuid())
  name          String
  displayName   String
  type          String
  isActive      Boolean  @default(true)
  countries     String?
  currency      String   @default("XOF")
  minAmount     Float    @default(100)
  maxAmount     Float    @default(500000)
  logoUrl       String?
  config        String?  @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CoinPack {
  id             String    @id @default(cuid())
  name           String
  description    String?
  coins          Int
  price          Float
  priceUSD       Float?
  priceEUR       Float?
  bonus          Int       @default(0)
  isPopular      Boolean   @default(false)
  isVip          Boolean   @default(false)
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  currency       String    @default("XOF")
  stripePriceId  String?
  cinetpayProductId String?
  promotionText  String?
  promotionEnd   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model VipBenefit {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String?
  type        String   @default("banner")
  targetUrl   String?
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  type      String
  phone     String?
  provider  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  status      String    @default("pending")
  method      String
  phone       String?
  notes       String?   @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ==================== HISTORIQUE & NOTIFICATIONS ====================

model WatchHistory {
  id            String   @id @default(cuid())
  userId        String
  videoId       String
  seriesId      String?
  episodeNumber Int?
  progress      Float    @default(0)
  completed     Boolean  @default(false)
  watchedAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, videoId])
  @@index([userId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  value     Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  videoId   String?
  type      String   @default("system")
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

// ==================== PUBLICITÉS ====================

model AdWatch {
  id           String   @id @default(cuid())
  userId       String
  episodeId    String
  rewardType   String   @default("free_episode")
  rewardAmount Int      @default(1)
  adProvider   String   @default("google")
  createdAt    DateTime @default(now())

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Video @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([createdAt])
}

model AdConfig {
  id                    String   @id @default(cuid())
  adProvider            String   @default("google")
  rewardedAdUnitId      String?
  interstitialUnitId    String?
  maxRewardedPerDay     Int      @default(5)
  freeEpisodesBeforeAd  Int      @default(3)
  adCooldownMinutes     Int      @default(5)
  rewardedAdReward      Int      @default(1)
  isActive              Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("ad_configs")
}

// ==================== SYSTÈME DE CADEAUX & BONUS ====================

// Récompenses quotidiennes par utilisateur
model DailyReward {
  id         String   @id @default(cuid())
  userId     String
  day        Int
  coins      Int
  claimedAt  DateTime
  createdAt  DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, day])
  @@index([userId])
  @@index([claimedAt])
}

// Suivi des séries (streak) de connexion
model UserStreak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastClaimDate DateTime?
  updatedAt     DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Missions utilisateur
model UserMission {
  id         String   @id @default(cuid())
  userId     String
  missionId  String   // 'watch_ad', 'watch_3_ads', 'share_app', 'watch_episode'
  progress   Int      @default(0)
  target     Int
  completed  Boolean  @default(false)
  claimedAt  DateTime?
  resetAt    DateTime // Pour reset quotidien/hebdomadaire
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, missionId])
  @@index([userId])
}

// Parrainages
model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String
  status       String   @default("pending") // pending, completed, rewarded
  coinsAwarded Int      @default(0)
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  
  referrer User @relation("sent", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("received", fields: [referredId], references: [id], onDelete: Cascade)
  
  @@unique([referredId])
  @@index([referrerId])
  @@index([status])
}

// Historique des récompenses
model RewardHistory {
  id         String   @id @default(cuid())
  userId     String
  type       String   // 'daily', 'mission', 'referral', 'bonus'
  amount     Int
  source     String   // 'day_1', 'watch_ad', 'invite_friend'
  createdAt  DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
}

// ==================== LOGS DE RECHERCHE ====================
// Pour les statistiques de recherche et suggestions populaires

model SearchLog {
  id          String   @id @default(cuid())
  query       String
  resultCount Int
  timestamp   DateTime @default(now())
  userId      String?
  
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([query])
  @@index([timestamp])
  @@index([userId])
}