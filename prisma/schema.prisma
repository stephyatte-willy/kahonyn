// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== UTILISATEURS ====================

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  name          String?
  email         String?   @unique
  preferredCurrency String? @default("XOF")
  country       String? 
  password      String?
  role          String    @default("client") 
  bio           String?   @db.Text
  avatar        String?
  coins         Int       @default(0)
  totalEarnings Float     @default(0)
  isActive      Boolean   @default(true) 
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  videos             Video[]
  series             Series[]
  purchases          Purchase[]
  subscriptions      Subscription[]
  watchHistory       WatchHistory[]
  likes              Like[]
  comments           Comment[]
  notifications      Notification[]
  paymentMethods     PaymentMethod[]
  withdrawalRequests WithdrawalRequest[]
  transactions       Transaction[]
  ratings            Rating[]
  adWatches          AdWatch[]      // ← NOUVEAU
}

// ==================== AUTH (NextAuth) ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== CONTENU VIDÉO ====================

model Video {
  id                String    @id @default(cuid())
  title             String
  description       String?   @db.Text
  thumbnail         String?
  url               String
  duration          Int       @default(0)
  price             Int       @default(0)
  freePreview       Boolean   @default(false)
  previewDuration   Int?
  views             Int       @default(0)
  purchasesCount    Int       @default(0)
  status            String    @default("pending")
  category          String    @default("popular")
  tags              String?
  deletionRequested Boolean   @default(false)
  isDeleted         Boolean   @default(false)
  willDisappearAt   DateTime?
  rejectionReason   String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creatorId     String
  creator       User           @relation(fields: [creatorId], references: [id])
  seriesId      String?
  series        Series?        @relation(fields: [seriesId], references: [id])
  purchases     Purchase[]
  likes         Like[]
  comments      Comment[]
  watchHistory  WatchHistory[]
  notifications Notification[]
  ratings       Rating[]
  adWatches     AdWatch[]      // ← NOUVEAU
}

model Series {
  id                String    @id @default(cuid())
  title             String
  description       String?   @db.Text
  coverImage        String?
  price             Int       @default(0)
  freeEpisodes      Int       @default(1)
  totalEpisodes     Int       @default(0)
  totalViews        Int       @default(0)
  status            String    @default("pending")
  category          String    @default("popular")
  deletionRequested Boolean   @default(false)
  isDeleted         Boolean   @default(false)
  willDisappearAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creatorId String
  creator   User      @relation(fields: [creatorId], references: [id])
  episodes  Video[]
  purchases Purchase[]
  likes     Like[]
  comments  Comment[]
}

// ==================== ENGAGEMENT ====================

model Like {
  id        String   @id @default(cuid())
  userId    String
  videoId   String?
  seriesId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video  Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@unique([userId, seriesId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  videoId   String?
  seriesId  String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video    Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  series   Series?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
}

// ==================== MONÉTISATION ====================

model Purchase {
  id            String    @id @default(cuid())
  userId        String
  videoId       String?
  seriesId      String?
  amount        Float
  coinsUsed     Int       @default(0)
  status        String    @default("completed")
  paymentMethod String    @default("coins")
  transactionId String?
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id])
  video  Video?  @relation(fields: [videoId], references: [id])
  series Series? @relation(fields: [seriesId], references: [id])
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  type            String    // coin_purchase, episode_purchase, subscription, withdrawal, admin_credit, admin_debit
  amount          Float     // Montant payé
  coins           Int       // Coins crédités/débités
  currency        String    @default("XOF") // XOF, USD, EUR
  paymentMethod   String    // wave, cinetpay, orange_money, coins, admin
  paymentGateway  String?   // Référence à PaymentGateway
  status          String    @default("pending")
  reference       String?   // Référence externe
  gatewayResponse String?   @db.Text // Réponse complète de la passerelle (JSON)
  metadata        String?   @db.Text
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([reference])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String   // XOF, USD, EUR
  toCurrency    String   // XOF, USD, EUR
  rate          Float    // Taux de conversion
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  planId           String?
  plan             String
  status           String    @default("active")
  amount           Float     @default(0)
  startDate        DateTime  @default(now())
  endDate          DateTime
  autoRenew        Boolean   @default(false)
  dailyCoinsClaimed Boolean  @default(false)
  lastDailyClaim   DateTime?
  createdAt        DateTime  @default(now())

  user    User              @relation(fields: [userId], references: [id])
  planRef SubscriptionPlan? @relation(fields: [planId], references: [id])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Float    @default(0)
  priceUSD    Float?
  duration    Int      @default(30)
  coinsBonus  Int      @default(0)
  dailyCoins  Int      @default(0)
  benefits    String?  @db.Text
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  color       String?
  badge       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model PaymentGateway {
  id            String   @id @default(cuid())
  name          String   // "wave", "cinetpay", "orange_money", "stripe"
  displayName   String   // "Wave Côte d'Ivoire", "Carte Bancaire (CinetPay)"
  type          String   // "mobile_money", "card", "international"
  isActive      Boolean  @default(true)
  countries     String?  // "CI,SN,ML" ou "ALL" pour tous les pays
  currency      String   @default("XOF") // XOF, USD, EUR
  minAmount     Float    @default(100)
  maxAmount     Float    @default(500000)
  logoUrl       String?  // URL du logo
  config        String?  @db.Text // JSON : clés API, secrets, etc.
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CoinPack {
  id             String    @id @default(cuid())
  name           String
  description    String?
  coins          Int
  price          Float     // Prix en FCFA (devise principale)
  priceUSD       Float?    // Prix en USD pour l'international
  priceEUR       Float?    // Prix en EUR
  bonus          Int       @default(0)
  isPopular      Boolean   @default(false)
  isVip          Boolean   @default(false)
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  currency       String    @default("XOF")
  stripePriceId  String?
  cinetpayProductId String? // ID produit CinetPay
  promotionText  String?
  promotionEnd   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model VipBenefit {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String?
  type        String   @default("banner")
  targetUrl   String?
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  type      String
  phone     String?
  provider  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  status      String    @default("pending")
  method      String
  phone       String?
  notes       String?   @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ==================== HISTORIQUE & NOTIFICATIONS ====================

model WatchHistory {
  id            String   @id @default(cuid())
  userId        String
  videoId       String
  seriesId      String?
  episodeNumber Int?
  progress      Float    @default(0) // Temps en secondes
  completed     Boolean  @default(false)
  watchedAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, videoId])
  @@index([userId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  value     Int      // 1 à 5
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  videoId   String?
  type      String   @default("system")
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

// ==================== PUBLICITÉS ====================

// Historique des publicités regardées par l'utilisateur
model AdWatch {
  id           String   @id @default(cuid())
  userId       String
  episodeId    String
  rewardType   String   @default("free_episode")  // 'free_episode', 'bonus_coins', 'skip_wait'
  rewardAmount Int      @default(1)               // 1 épisode ou X coins
  adProvider   String   @default("google")       // google, unity, applovin
  createdAt    DateTime @default(now())

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Video @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])  // Une pub par épisode max
  @@index([userId])
  @@index([createdAt])
}

// Configuration des publicités (une seule ligne de configuration)
model AdConfig {
  id                    String   @id @default(cuid())
  adProvider            String   @default("google")     // google, unity, applovin
  rewardedAdUnitId      String?                         // ID unité publicitaire récompensée
  interstitialUnitId    String?                         // ID unité interstitielle
  maxRewardedPerDay     Int      @default(5)            // Max pubs récompensées par jour
  freeEpisodesBeforeAd  Int      @default(3)            // 3 épisodes gratuits puis pub forcée
  adCooldownMinutes     Int      @default(5)            // Temps entre deux pubs forcées (minutes)
  rewardedAdReward      Int      @default(1)            // Nombre d'épisodes débloqués par pub
  isActive              Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("ad_configs")
}