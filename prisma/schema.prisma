generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MODÈLE USERS
// ============================================================
model users {
  id             String             @id @default(cuid()) @db.VarChar(191)
  phone          String             @unique @db.VarChar(191)
  name           String?            @db.VarChar(191)
  email          String?            @unique @db.VarChar(191)
  password       String?            @db.VarChar(191)
  role           String             @default("user") @db.VarChar(50)
  coins          Int                @default(0)
  avatar         String?            @db.VarChar(500)
  bio            String?            @db.Text
  totalEarnings  Int                @default(0)
  totalWithdrawn Int                @default(0)
  isActive       Boolean            @default(true)
  emailVerified  DateTime?
  lastLogin      DateTime?
  createdAt      DateTime           @default(now()) @map("createdAt")
  updatedAt      DateTime           @updatedAt @map("updatedAt")
  earnings       creator_earnings[]
  purchases      purchases[]
  progress       userProgress[]
  videos         videos[]
  withdrawals    withdrawals[]
  likes          userLikes[]
  saves          userSaves[]
  subscriptions  subscriptions[]
  coinTransactions coinTransactions[]

  @@map("users")
}

// ============================================================
// MODÈLE VIDEOS (UNIFIÉ)
// ============================================================
model videos {
  id            String             @id @default(cuid()) @db.VarChar(191)
  title         String             @db.VarChar(255)
  description   String?            @db.Text
  url           String             @db.VarChar(500)
  thumbnail     String?            @db.VarChar(500)
  duration      Int?
  price         Int                @default(100)
  views         Int                @default(0)
  purchases     Int                @default(0)
  status        String             @default("pending") @db.VarChar(50)
  creatorId     String             @db.VarChar(191)
  isSeries      Boolean            @default(false)
  parentId      String?            @db.VarChar(191)
  episodeNumber Int?
  startTime     Int?
  endTime       Int?
  publicId      String?            @db.VarChar(191)
  category      String             @default("all") @db.VarChar(50)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  earnings      creator_earnings[]
  transactions  purchases[]
  progress      userProgress[]
  likes         userLikes[]
  saves         userSaves[]
  creator       users              @relation(fields: [creatorId], references: [id])
  parent        videos?            @relation("SeriesEpisodes", fields: [parentId], references: [id])
  episodes      videos[]           @relation("SeriesEpisodes")

  @@index([creatorId])
  @@index([parentId])
  @@index([status])
  @@index([category])
  @@index([isSeries])
  @@map("videos")
}

// ============================================================
// MODÈLE PURCHASES
// ============================================================
model purchases {
  id            String   @id @default(cuid()) @db.VarChar(191)
  userId        String   @db.VarChar(191)
  videoId       String   @db.VarChar(191)
  amount        Int
  status        String   @default("completed") @db.VarChar(50)
  transactionId String?  @unique @db.VarChar(191)
  createdAt     DateTime @default(now())
  user          users    @relation(fields: [userId], references: [id])
  video         videos   @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@map("purchases")
}

// ============================================================
// MODÈLE CREATOR_EARNINGS
// ============================================================
model creator_earnings {
  id        String    @id @default(cuid()) @db.VarChar(191)
  creatorId String    @db.VarChar(191)
  videoId   String    @db.VarChar(191)
  amount    Int
  status    String    @default("pending") @db.VarChar(50)
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  creator   users     @relation(fields: [creatorId], references: [id])
  video     videos    @relation(fields: [videoId], references: [id])

  @@index([creatorId])
  @@index([videoId])
  @@map("creator_earnings")
}

// ============================================================
// MODÈLE WITHDRAWALS
// ============================================================
model withdrawals {
  id          String    @id @default(cuid()) @db.VarChar(191)
  creatorId   String    @db.VarChar(191)
  amount      Int
  phone       String    @db.VarChar(50)
  status      String    @default("pending") @db.VarChar(50)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  creator     users     @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@map("withdrawals")
}

// ============================================================
// MODÈLE USER_PROGRESS
// ============================================================
model userProgress {
  id          String   @id @default(cuid()) @db.VarChar(191)
  userId      String   @db.VarChar(191)
  episodeId   String   @db.VarChar(191)
  currentTime Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        users    @relation(fields: [userId], references: [id])
  episode     videos   @relation(fields: [episodeId], references: [id])

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([episodeId])
  @@map("user_progress")
}

// ============================================================
// MODÈLE USER_LIKES
// ============================================================
model userLikes {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  episodeId String   @db.VarChar(191)
  createdAt DateTime @default(now())

  user    users  @relation(fields: [userId], references: [id])
  episode videos @relation(fields: [episodeId], references: [id])

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([episodeId])
  @@map("user_likes")
}

// ============================================================
// MODÈLE USER_SAVES
// ============================================================
model userSaves {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  episodeId String   @db.VarChar(191)
  createdAt DateTime @default(now())

  user    users  @relation(fields: [userId], references: [id])
  episode videos @relation(fields: [episodeId], references: [id])

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([episodeId])
  @@map("user_saves")
}

// ============================================================
// MODÈLE SUBSCRIPTIONS (Abonnements)
// ============================================================
model subscriptions {
  id          String   @id @default(cuid()) @db.VarChar(191)
  userId      String   @db.VarChar(191)
  plan        String   @db.VarChar(50) // monthly, quarterly, yearly
  status      String   @default("active") @db.VarChar(50) // active, cancelled, expired
  startDate   DateTime @default(now())
  endDate     DateTime
  autoRenew   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        users    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

// ============================================================
// MODÈLE COIN_PACKS (Packs de coins)
// ============================================================
model coinPacks {
  id          String   @id @default(cuid()) @db.VarChar(191)
  name        String   @db.VarChar(191)
  coins       Int
  price       Int      // prix en FCFA
  bonus       Int      @default(0)
  isPopular   Boolean  @default(false)
  isVip       Boolean  @default(false)
  createdAt   DateTime @default(now())

  transactions coinTransactions[]

  @@map("coin_packs")
}

// ============================================================
// MODÈLE COIN_TRANSACTIONS
// ============================================================
model coinTransactions {
  id            String   @id @default(cuid()) @db.VarChar(191)
  userId        String   @db.VarChar(191)
  packId        String?  @db.VarChar(191)
  amount        Int      // nombre de coins
  price         Int      // prix payé en FCFA
  status        String   @default("pending") @db.VarChar(50) // pending, completed, failed
  transactionId String?  @unique @db.VarChar(191)
  paymentMethod String   @default("orange_money") @db.VarChar(50)
  paymentUrl    String?  @db.VarChar(500) // ← AJOUTER CETTE LIGNE
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  user        users     @relation(fields: [userId], references: [id])
  pack        coinPacks? @relation(fields: [packId], references: [id])

  @@index([userId])
  @@index([packId])
  @@index([status])
  @@map("coin_transactions")
}