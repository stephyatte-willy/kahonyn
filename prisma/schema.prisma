// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== UTILISATEURS ====================

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  name          String?
  email         String?   @unique
  password      String?
  role          String    @default("client") // admin, creator, client
  bio           String?   @db.Text
  avatar        String?
  coins         Int       @default(0)        // Solde de pièces virtuelles pour consommer
  totalEarnings Float     @default(0)        // Gains réels accumulés (ex: en FCFA) par le créateur
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  videos             Video[]
  series             Series[]
  purchases          Purchase[]
  subscriptions      Subscription[]
  watchHistory       WatchHistory[]
  likes              Like[]
  comments           Comment[]
  notifications      Notification[]
  paymentMethods     PaymentMethod[]
  withdrawalRequests WithdrawalRequest[]
}

// ==================== AUTH (NextAuth) ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== CONTENU VIDÉO ====================

model Video {
  id                String    @id @default(cuid())
  title             String
  description       String?   @db.Text
  thumbnail         String?
  url               String    // ID public Cloudinary ou URL Cloudinary HLS (.m3u8)
  duration          Int       @default(0) // secondes
  price             Int       @default(0) // CORRIGÉ : Prix en PIÈCES VIRTUELLES (ex: 10 pièces l'épisode)
  freePreview       Boolean   @default(false)
  previewDuration   Int?      // secondes de preview gratuite
  views             Int       @default(0)
  purchasesCount    Int       @default(0)
  status            String    @default("pending") // pending, approved, rejected, archived
  category          String    @default("popular")
  tags              String?   // tags séparés par des virgules
  deletionRequested Boolean   @default(false)
  isDeleted         Boolean   @default(false)
  willDisappearAt   DateTime?
  rejectionReason   String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  creatorId     String
  creator       User           @relation(fields: [creatorId], references: [id])
  seriesId      String?
  series        Series?        @relation(fields: [seriesId], references: [id])
  purchases     Purchase[]
  likes         Like[]
  comments      Comment[]
  watchHistory  WatchHistory[]
  notifications Notification[]
}

model Series {
  id                String    @id @default(cuid())
  title             String
  description       String?   @db.Text
  coverImage        String?
  price             Int       @default(0) // CORRIGÉ : Prix global de la série en PIÈCES si achat groupé
  freeEpisodes      Int       @default(1)
  totalEpisodes     Int       @default(0)
  totalViews        Int       @default(0)
  status            String    @default("pending") // pending, approved, rejected
  category          String    @default("popular")
  deletionRequested Boolean   @default(false)
  isDeleted         Boolean   @default(false)
  willDisappearAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  creatorId String
  creator   User      @relation(fields: [creatorId], references: [id])
  episodes  Video[]
  purchases Purchase[]
  likes     Like[]
  comments  Comment[]
}

// ==================== ENGAGEMENT ====================

model Like {
  id        String   @id @default(cuid())
  userId    String
  videoId   String?
  seriesId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video  Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@unique([userId, seriesId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  videoId   String?
  seriesId  String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video    Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  series   Series?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
}

// ==================== MONÉTISATION ====================

model Purchase {
  id            String   @id @default(cuid())
  userId        String
  videoId       String?
  seriesId      String?
  amount        Float    // Montant équivalent si payé directement en monnaie fiscale
  coinsUsed     Int      @default(0) // Nombre de jetons dépensés pour cet achat
  status        String   @default("completed") // completed, refunded, pending
  paymentMethod String   @default("coins")     // coins, orange_money, wave
  transactionId String?
  createdAt     DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  video  Video?  @relation(fields: [videoId], references: [id])
  series Series? @relation(fields: [seriesId], references: [id])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String   // monthly, quarterly, yearly
  status    String   @default("active") // active, cancelled, expired
  amount    Float    // Prix payé en FCFA
  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CoinPack {
  id        String   @id @default(cuid())
  name      String
  coins     Int
  price     Float    // Prix réel en FCFA (ex: 500 FCFA)
  bonus     Int      @default(0)
  isPopular Boolean  @default(false)
  isVip     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  type      String   // wave, mobile_money, card
  phone     String?
  provider  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id          String    @id @default(cuid())
  userId      String
  amount      Float     // Somme en FCFA retirée par le créateur
  status      String    @default("pending") // pending, approved, rejected, paid
  method      String    // wave, mobile_money, bank
  phone       String?
  notes       String?   @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ==================== HISTORIQUE & NOTIFICATIONS ====================

model WatchHistory {
  id            String   @id @default(cuid())
  userId        String
  videoId       String
  seriesId      String?
  episodeNumber Int?
  progress      Float    @default(0) // pourcentage 0-100
  completed     Boolean  @default(false)
  watchedAt     DateTime @default(now())

  // CORRIGÉ : Ajout des relations manquantes exigées par Prisma
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // INDEXATION : Accélère le chargement de la reprise de lecture pour l'utilisateur
  @@index([userId, videoId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  videoId   String?
  type      String   // "like", "comment", "system"
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [videoId], references: [id], onDelete: Cascade)
}
